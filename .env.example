# MerchantOS local defaults — copy to `.env` and override locally.
# Do not commit real secrets. Never commit `.env` — `.env.example` only (ADR-068).
# Values below are non-secret local-parity defaults / placeholders (ADR-066 / ADR-068).

# --- App (optional compose profile: app) ---
# Host port for Next (local remaps away from other stacks; arix uses 3119).
# Production image: docker compose --profile app up --build -d
APP_PORT=3020
# Host-side tooling default; compose `app` service forces NODE_ENV=production.
NODE_ENV=development
APP_URL=http://localhost:3020

# --- Auth (ADR-068 / ADR-033 / ADR-095) — separate from DB/Redis/MinIO passwords ---
# Generate a unique value for each environment. Rejected as-is in production.
# Example: openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret
# Optional: force OTP in JSON responses outside NODE_ENV=development (never for real staging/prod traffic)
# MOS_RETURN_DEV_OTP=1
# Deployed environment label (local | staging | production). Console SMS only when local or NODE_ENV=development.
MOS_ENV=local
# Payment Provider selection (sandbox | zarinpal). Defaults to zarinpal if ZARINPAL_MERCHANT_ID set, else sandbox.
MOS_PAYMENT_PROVIDER=zarinpal
# ZarinPal Merchant ID
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# ZarinPal Sandbox mode (true | false)
ZARINPAL_SANDBOX=true

# ADR-102 — allow POST /api/v1/payments/{id}/sandbox/confirm (never in staging/production)
MOS_ALLOW_SANDBOX_PAYMENT_CONFIRM=1
# When MOS_ENV=production and still using sandbox PSP, acknowledge explicitly (ADR-123):
# MOS_ALLOW_SANDBOX_PAYMENT_GATEWAY=1
# Optional HMAC secret for sandbox webhooks (default: merchantos-sandbox-webhook)
# MOS_PAYMENTS_WEBHOOK_SECRET=merchantos-sandbox-webhook
# Never force console SMS outside local/development (ADR-095 / ADR-123):
# MOS_FORCE_CONSOLE_SMS=1
# Comma-separated browser origins allowed for credentialed CORS (ADR-119). Localhost defaults always included.
# CORS_ALLOWED_ORIGINS=https://app.example.ir,https://preview.example.ir

# --- PostgreSQL OLTP (never replace with Mongo as SoT) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=merchantos
POSTGRES_PASSWORD=merchantos
POSTGRES_DB=merchantos
DATABASE_URL=postgres://merchantos:merchantos@localhost:5433/merchantos

# Persian UTF-8 readiness is encoded in compose (POSTGRES_INITDB_ARGS / LANG).
# Do not force ASCII-only client encodings.

# --- MongoDB analytics / audit / telemetry plane (NOT OLTP SoT) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=merchantos
MONGO_INITDB_ROOT_PASSWORD=merchantos
MONGO_DB=merchantos_analytics
MONGODB_URL=mongodb://merchantos:merchantos@localhost:27017/merchantos_analytics?authSource=admin
# MOS_MONGO_MODE=memory  # force in-memory analytics stores (tests); default live when MONGODB_URL set

# --- Redis cache / rate-limit ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
# Mock path for unit tests / offline local: memory | mock
# Leave unset (or any other value) to use live REDIS_URL (ADR-108).
# MOS_REDIS_MODE=memory

# --- EMQX MQTT / realtime ---
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public
MQTT_URL=mqtt://localhost:1883
# Browser MQTT-over-WS (ADR-124): Compose maps EMQX WS to host :8083 path /mqtt
# NEXT_PUBLIC_MOS_ENV=local
# Force poll-only fallback (no MQTT.js connect) for tests / flaky networks:
# NEXT_PUBLIC_MOS_MQTT_CLIENT=0
# MOS_MQTT_MODE=memory  # force InMemoryMqttBroker (tests); default live when MQTT_URL set
# Outbox worker (ADR-109): docker compose --profile worker up worker
# MOS_OUTBOX_POLL_MS=1000
# MOS_SCHEDULED_JOB_MS=60000
# Optional MQTT auth (Compose EMQX default allows anonymous locally):
# MQTT_USERNAME=
# MQTT_PASSWORD=

# --- MinIO object storage (ADR-040 / ADR-111) ---
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9010
MINIO_CONSOLE_URL=http://localhost:9011
# MOS_MINIO_MODE=memory  # force in-memory ObjectStoragePort (tests); default live when MINIO_ENDPOINT set

# --- Readiness probe (ADR-112) — GET /api/ready ---
# Postgres + Redis are always required. Optional planes fail closed only when flagged:
# MOS_READY_REQUIRE_MONGO=1
# MOS_READY_REQUIRE_EMQX=1
# MOS_READY_REQUIRE_MINIO=1

# --- Static maps (ADR-104) — optional; without keys storefront shows address + Navigate ---
# Template placeholders: {lat} {lng} {width} {height} {zoom}
# MOS_STATIC_MAP_URL_TEMPLATE=https://maps.example/static?lat={lat}&lng={lng}&w={width}&h={height}&z={zoom}
# NESHAN_API_KEY=
# MOS_NESHAN_API_KEY=
# Public origin used when encoding absolute QR targets for print stickers
# NEXT_PUBLIC_APP_URL=http://localhost:3020
# APP_URL=http://localhost:3020

# --- Accounting integration (ADR-126 / ADR-140) — server/worker only; never browser/POS ---
# noop (default CI) | fake (tests) | erpnext (local Docker financial brain)
MOS_ACCOUNTING_PROVIDER=noop
# Local ERPNext sidecar: docker compose -f docker-compose.erpnext.yml up -d
# Desk host port (default 8080; use 8088 when 8080 is taken):
# ERPNEXT_PORT=8088
# Then: npm run erpnext:bootstrap
# MOS_ERPNEXT_URL=http://localhost:8088
# MOS_ERPNEXT_API_KEY=
# MOS_ERPNEXT_API_SECRET=
# MOS_ERPNEXT_COMPANY=MerchantOS Demo
# MOS_ERPNEXT_WAREHOUSE=Stores - MD
# MOS_ERPNEXT_DEFAULT_CUSTOMER=Cash Customer
# MOS_ERPNEXT_CURRENCY=IRR
# MOS_ERPNEXT_TIMEOUT_MS=30000
